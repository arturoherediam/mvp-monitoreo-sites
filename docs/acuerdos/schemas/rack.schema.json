{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telemetría del nodo rack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "node_id",
    "seq",
    "uptime_s",
    "positions"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "type": {
      "const": "rack"
    },
    "node_id": {
      "type": "string",
      "pattern": "^rack-[0-9]{2}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "uptime_s": {
      "type": "integer",
      "minimum": 0
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/position"
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "temp",
        "hum",
        "dew_point",
        "rate_c_min"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-H]$"
        },
        "temp": {
          "type": [
            "number",
            "null"
          ]
        },
        "hum": {
          "type": [
            "number",
            "null"
          ]
        },
        "dew_point": {
          "type": [
            "number",
            "null"
          ]
        },
        "rate_c_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "flame": {
          "type": "boolean"
        },
        "err": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          }
        }
      }
    }
  }
}
