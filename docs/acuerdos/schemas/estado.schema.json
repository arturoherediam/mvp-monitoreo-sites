{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estado del nodo (retenido, y LWT)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "node_id",
    "status"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "node_id": {
      "type": "string",
      "pattern": "^(rack|amb)-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "online",
        "offline"
      ]
    },
    "fw": {
      "type": "string"
    },
    "sensors": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
