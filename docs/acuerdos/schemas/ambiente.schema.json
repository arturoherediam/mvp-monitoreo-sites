{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telemetría del nodo ambiente",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "node_id",
    "seq",
    "uptime_s",
    "temp",
    "hum",
    "dew_point",
    "rate_c_min",
    "pm1_0",
    "pm2_5",
    "pm10"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "type": {
      "const": "ambiente"
    },
    "node_id": {
      "type": "string",
      "pattern": "^amb-[0-9]{2}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "uptime_s": {
      "type": "integer",
      "minimum": 0
    },
    "temp": {
      "type": [
        "number",
        "null"
      ]
    },
    "hum": {
      "type": [
        "number",
        "null"
      ]
    },
    "dew_point": {
      "type": [
        "number",
        "null"
      ]
    },
    "rate_c_min": {
      "type": [
        "number",
        "null"
      ]
    },
    "pm1_0": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "pm2_5": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "pm10": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "err": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      }
    }
  }
}
